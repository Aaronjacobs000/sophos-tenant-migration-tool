{
  "name": "sophos-tenant-migration-tool",
  "version": "0.5.3",
  "description": "Unofficial, locally run web tool for migrating configuration and devices between two Sophos Fusion (formerly Sophos Central) tenants.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aaronjacobs000/sophos-tenant-migration-tool.git"
  },
  "homepage": "https://github.com/Aaronjacobs000/sophos-tenant-migration-tool#readme",
  "bugs": {
    "url": "https://github.com/Aaronjacobs000/sophos-tenant-migration-tool/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "start": "npm run build && node backend/dist/server.js",
    "dev": "tsc --watch & node --watch backend/dist/server.js",
    "clean": "rimraf backend/dist",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.21.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.9.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.6.3"
  }
}
